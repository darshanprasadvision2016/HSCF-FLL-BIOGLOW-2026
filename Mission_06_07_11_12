from hub import port, motion_sensor
import runloop
import motor_pair
import motor

PAIR = motor_pair.PAIR_1
PAIR1 = motor_pair.PAIR_2

# Drive motors
motor_pair.pair(PAIR, port.A, port.C)

# Attachment motors
motor_pair.pair(PAIR1, port.D, port.E)

# --------------------------------------------------
# GYRO FORWARD
# --------------------------------------------------

async def gyro_forward(degrees, max_velocity=600):
    motor.reset_relative_position(port.A, 0)
    motor.reset_relative_position(port.C, 0)

    await runloop.until(motion_sensor.stable)
    motion_sensor.reset_yaw(0)

    last_yaw = 0
    target = abs(degrees)

    while True:
        left = abs(motor.relative_position(port.A))
        right = abs(motor.relative_position(port.C))
        travelled = (left + right) / 2

        if travelled >= target:
            break

        remaining = target - travelled

        if travelled < 100:
            velocity = 350
        elif remaining < 120:
            velocity = 300
        else:
            velocity = max_velocity

        yaw = motion_sensor.tilt_angles()[0] / 10
        p = yaw * 2.0
        d = (yaw - last_yaw) * 0.8
        correction = int(p + d)
        correction = max(-25, min(25, correction))

        motor_pair.move(PAIR, correction, velocity=velocity)

        last_yaw = yaw
        await runloop.sleep_ms(10)

    motor_pair.stop(PAIR)


# --------------------------------------------------
# GYRO BACKWARD
# --------------------------------------------------

async def gyro_backward(degrees, velocity=600):
    motor.reset_relative_position(port.A, 0)
    motor.reset_relative_position(port.C, 0)

    await runloop.until(motion_sensor.stable)
    motion_sensor.reset_yaw(0)

    last_yaw = 0
    direction = 1 if degrees >= 0 else -1
    target = abs(degrees)

    while True:
        left = abs(motor.relative_position(port.A))
        right = abs(motor.relative_position(port.C))
        travelled = (left + right) / 2

        if travelled >= target:
            break

        yaw = motion_sensor.tilt_angles()[0] / 10
        p = yaw * 2.0
        d = (yaw - last_yaw) * 0.8
        correction = int(p + d)
        correction = max(-25, min(25, correction))

        steering = correction * direction
        motor_pair.move(
            PAIR,
            steering,
            velocity=velocity * direction
        )

        last_yaw = yaw
        await runloop.sleep_ms(10)

    motor_pair.stop(PAIR)


